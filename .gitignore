# ---------------------------------------------------------------------------
# .gitignore for the Flood Frequency Analysis project (uv-based)
# ---------------------------------------------------------------------------

# Virtual environment
.venv/

# uv
# (keep uv.lock tracked in git so installs are reproducible across machines -
#  do NOT ignore it unless you have a specific reason to)

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Input data -- kept locally only, not tracked in git, EXCEPT the shipped
# example/template files, which ALL live under Data/Templates/ (case-first
# layout, v0.8.0). A real case is Data/<CaseName>/... and is never tracked;
# only Data/Templates/ ships with the repo, so a fresh clone has something to
# try immediately. This one exception subtree replaces the earlier scattered
# per-file exceptions.
/Data/*
!/Data/.gitkeep
!/Data/Templates/

# Generated output -- regenerated locally, not tracked in git
/Output/*
!/Output/.gitkeep

# Generated plots -- regenerated locally, not tracked in git
/Plot/*
!/Plot/.gitkeep

# Logs
*.log

# This file itself -- included in delivery zips as a cover letter for you,
# not meant to be part of the tracked project
MANIFEST.txt