# ---------------------------------------------------------------------------
# .gitignore for the Flood Frequency Analysis project (uv-based)
# ---------------------------------------------------------------------------

# Virtual environment
.venv/

# uv
# (keep uv.lock tracked in git so installs are reproducible across machines -
#  do NOT ignore it unless you have a specific reason to)

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Input data -- kept locally only, not tracked in git
/Data/*
!/Data/.gitkeep

# Generated output -- regenerated locally, not tracked in git
/Output/*
!/Output/.gitkeep

# Generated plots -- regenerated locally, not tracked in git
/Plot/*
!/Plot/.gitkeep

# Logs
*.log