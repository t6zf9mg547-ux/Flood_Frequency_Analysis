# ---------------------------------------------------------------------------
# .gitignore for the Flood Frequency Analysis project (uv-based)
# ---------------------------------------------------------------------------

# Virtual environment
.venv/

# uv
# (keep uv.lock tracked in git so installs are reproducible across machines -
#  do NOT ignore it unless you have a specific reason to)

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Input data -- kept locally only, not tracked in git, EXCEPT the bundled
# example/template files below (shipped so a fresh clone/checkout has
# something to try immediately -- without these exceptions, everything
# under Data/ would be silently excluded, templates included, even though
# they're meant to ship with the repo)
/Data/*
!/Data/.gitkeep
!/Data/Template.csv
!/Data/Templates/
!/Data/Templates/*.csv
!/Data/Templates/discharge_station_data/
!/Data/Templates/discharge_station_data/*.csv
!/Data/Templates/rainfall_station_data/
!/Data/Templates/rainfall_station_data/*.csv
!/Data/Regional/
/Data/Regional/*
!/Data/Regional/Template/
!/Data/Regional/Template/*.csv

# Generated output -- regenerated locally, not tracked in git
/Output/*
!/Output/.gitkeep

# Generated plots -- regenerated locally, not tracked in git
/Plot/*
!/Plot/.gitkeep

# Logs
*.log

# This file itself -- included in delivery zips as a cover letter for you,
# not meant to be part of the tracked project
MANIFEST.txt
