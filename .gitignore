# ---------------------------------------------------------------------------
# .gitignore template for uv-based Python projects (geopandas/GIS scripts)
# ---------------------------------------------------------------------------

# Virtual environment
.venv/

# uv
# (keep uv.lock tracked in git so installs are reproducible across machines -
#  do NOT ignore it unless you have a specific reason to)

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Project data & outputs - regenerated / local-only, not tracked in git
Data/
Output/
Plot/

# Logs
*.log